# Copy to .env and fill in. Never commit real values.
# Get these from https://developer.ebay.com/my/keys (Application Keys page).

# Required: your eBay developer App ID (client_id) and Cert ID (client_secret)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Environment: sandbox (default, test data) or production (real listings/orders)
EBAY_ENV=sandbox

# Marketplace for Browse API searches (default EBAY_US)
EBAY_MARKETPLACE=EBAY_US

# Optional: user access token (Authorization Code grant) — required for place_bid
# on auction items. Print the consent URL with the snippet in the README's
# Setup step 4, approve it in a browser, then exchange the ?code=... for
# tokens via ebay_mcp.auth.exchange_code_for_tokens and paste them here.
EBAY_USER_ACCESS_TOKEN=
EBAY_USER_REFRESH_TOKEN=

# Optional: your RuName (redirect URI name) registered in the developer portal,
# used to build the user-consent URL
EBAY_RUNAME=

# Optional: server + watchlist settings
EBAY_HOST=127.0.0.1
EBAY_PORT=8000
EBAY_WATCHLIST_PATH=./data/watchlist.json

# Integration tests only: set to 1 to allow live mutating calls (bids/orders)
# against the SANDBOX. Never enable with EBAY_ENV=production.
EBAY_RUN_LIVE_MUTATIONS=0
